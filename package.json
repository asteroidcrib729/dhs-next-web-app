{
  "name": "digital-horizon-systems-web",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "clean": "rimraf .next",
    "setup": "node scripts/setup.mjs && prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check . && node scripts/check-prisma-format.mjs",
    "db:check": "tsx scripts/check-database.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run typecheck && npm run db:validate && npm run assets:check",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test": "tsx --test tests/*.test.ts",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "studio:admin": "tsx scripts/studio-admin.ts",
    "studio:import": "tsx scripts/studio-import.ts",
    "studio:check": "tsx scripts/check-editorial.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@react-email/render": "2.1.1",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nprogress": "0.2.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.34.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nprogress": "0.2.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1"
}
