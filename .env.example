# Copy this file to .env or run npm run setup. Never commit real credentials.
# Required for contact storage and the editorial studio (PostgreSQL).
# Example: postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/digital_horizon
DATABASE_URL=
# Optional direct PostgreSQL URL for migrations. Application traffic uses DATABASE_URL.
DIRECT_DATABASE_URL=

# Editorial studio. Server-only. Generate a random secret with at least 32 characters.
# Use the exact application origin; HTTPS is required outside loopback development.
# Vercel previews use the trusted VERCEL_URL deployment hostname automatically.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Public canonical site origin for SEO and sitemap. Set your real domain before launch.
SITE_URL=http://localhost:3000
# Account bootstrap/reset command only. Clear these after provisioning the account.
STUDIO_ADMIN_EMAIL=
STUDIO_ADMIN_PASSWORD=

# Optional: contact notification email is skipped when this is empty.
RESEND_API_KEY=
# Use a verified sender/domain and your own destination before enabling email.
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Keep false in production. Never exposes database credentials.
DEBUG_ERRORS=false

# Set NODE_ENV through Next.js scripts; do not put it here.
# Optional PORT defaults to 3000; use npm run dev -- --port 3001 to override.
# Set NODE_OPTIONS in the launching shell if a memory limit is needed.

# Public website settings. These are intentionally sent to the browser.
# Blank contact details are hidden. Restart dev / rebuild production after editing.
SITE_PHONE=
SITE_WHATSAPP_NUMBER=
SITE_PUBLIC_EMAIL=
SITE_CONSULTATION_URL=/contact
SITE_ADDRESS=
SITE_OFFICE_HOURS=
SITE_MAP_EMBED_URL=

# Existing destinations retained for review; edit or leave blank to disable.
SITE_PARTNER_SANGFOR="https://www.sangfor.com/partners/become-a-partner"
SITE_PARTNER_VMWARE="https://partnerportal.broadcom.com/web/partner-portal"
SITE_PARTNER_MICROSOFT="https://partner.microsoft.com/"
SITE_PARTNER_ORACLE="https://www.oracle.com/partnernetwork/program"
SITE_PARTNER_H3C="https://www.h3c.com/en/Partners/"
SITE_PARTNER_CONSTRUCTOR="https://constructor.tech/partners"
SITE_PARTNER_VEEAM="https://www.veeam.com/partners/propartner.html"
SITE_PARTNER_ZWSOFT="https://partnerportal.zwsoft.com/"
SITE_PARTNER_BARRACUDA="https://www.barracuda.com/partners/become-a-partner"
SITE_PARTNER_SOLARWINDS="https://www.solarwinds.com/partners"
SITE_PARTNER_GOOGLE="https://www.google.com/partners/"
SITE_PARTNER_GOOGLE_CLOUD="https://cloud.google.com/partners"
SITE_PARTNER_META="https://www.facebook.com/business/partner-directory"
SITE_PARTNER_X="https://business.x.com/"
SITE_PARTNER_TIKTOK="https://ads.tiktok.com/marketing-partners/"
SITE_PARTNER_CLUTCH="https://clutch.co/"
SITE_PARTNER_SHOPIFY="https://www.shopify.com/partners"
SITE_PARTNER_HUBSPOT="https://ecosystem.hubspot.com/marketplace/solutions"
SITE_PARTNER_AWS="https://partners.amazonaws.com/"
SITE_PROJECT_ENG="https://eng-properties.com/"
SITE_PROJECT_JSN="https://jsnmedical.com.au/"
SITE_PROJECT_MISSION="https://missionhealthcare.com.au/"
SITE_PROJECT_NECTRONIX="https://nectronix.com/"
SITE_PROJECT_711="https://711maxbachat.com/"
SITE_PROJECT_SHARZ="https://sharzproperties.com/"
# Blank social profile URLs open the official platform homepages.
SITE_SOCIAL_FACEBOOK_URL=
SITE_SOCIAL_INSTAGRAM_URL=
SITE_SOCIAL_LINKEDIN_URL=

# Public policy dates, ISO YYYY-MM-DD. Each policy has independent dates.
SITE_TERMS_EFFECTIVE_DATE=2026-10-23
SITE_TERMS_LAST_REVIEWED_DATE=2026-10-23
SITE_PRIVACY_EFFECTIVE_DATE=2026-10-23
SITE_PRIVACY_LAST_REVIEWED_DATE=2026-10-23
SITE_COOKIES_EFFECTIVE_DATE=2026-10-23
SITE_COOKIES_LAST_REVIEWED_DATE=2026-10-23
