generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model contact {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String
  phone      String?
  company    String?
  industry   String?
  service    String
  budget     String?
  message    String
  newsletter Boolean  @default(false)
  terms      Boolean
  createdAt  DateTime @default(now())
}
